# AirFLAC configuration.
# Every value below is optional -- AirFLAC runs correctly with no configuration at all.
# Copy to .env (or /etc/airflac/airflac.env for native installs) and edit as needed.

# Network interface and port the server binds to.
AIRFLAC_HOST=0.0.0.0
AIRFLAC_PORT=8080

# Maximum size of a single uploaded file, in megabytes.
AIRFLAC_MAX_UPLOAD_MB=1000

# How long uploaded, converted and archived files are kept before cleanup removes them.
AIRFLAC_FILE_RETENTION_HOURS=24

# Default FLAC compression level (0-12). Affects encoding time and file size, not audio quality.
AIRFLAC_FLAC_COMPRESSION_LEVEL=5

# Where uploads, converted files and ZIP archives are written.
AIRFLAC_STORAGE_PATH=./storage

# How many files may be converted at the same time.
AIRFLAC_MAX_CONCURRENT_CONVERSIONS=2

# Maximum size of an uploaded album art image, in megabytes.
AIRFLAC_MAX_ARTWORK_MB=10

# Set to true only when running behind a reverse proxy you control, so that
# client IPs are read from X-Forwarded-For. Leave false if the server is reached directly.
AIRFLAC_TRUST_PROXY=false

# Log level: debug, info, warn, error.
AIRFLAC_LOG_LEVEL=info
