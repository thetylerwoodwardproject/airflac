[Unit]
Description=AirFLAC lossless audio conversion for broadcast
Documentation=https://github.com/thetylerwoodwardproject/airflac-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airflac
Group=airflac
WorkingDirectory=/opt/airflac
EnvironmentFile=/etc/airflac/airflac.env
ExecStart=/usr/bin/node /opt/airflac/server/dist/index.js
Restart=on-failure
RestartSec=5

# AirFLAC stops its own ffmpeg processes on SIGTERM; this allows time for that.
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airflac
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
